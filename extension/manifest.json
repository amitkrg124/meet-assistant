{
  "manifest_version": 3,
  "name": "Meet Assistant",
  "version": "0.1.0",
  "description": "Private side-panel assistant: listens through your microphone (or Google Meet captions), spots questions and drafts answers with OpenAI.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Meet Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "answer-last": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Answer the latest question"
    }
  }
}
